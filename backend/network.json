    {"source": "server_web", "destination": "server_api", "ports": [443], "protocol": "TCP", "allowed": true, "reason": "Application service communication"},
    {"source": "server_api", "destination": "server_files", "ports": [445], "protocol": "TCP", "allowed": true, "reason": "Application file access"},
    {"source": "server_dns", "destination": "gateway_edge", "ports": [53], "protocol": "UDP", "allowed": true, "reason": "External DNS resolution"},
    {"source": "workstation_it", "destination": "security_monitor", "ports": [443], "protocol": "TCP", "allowed": true, "reason": "Security administration"},
    {"source": "gateway_edge", "destination": "security_monitor", "ports": [443], "protocol": "TCP", "allowed": true, "reason": "Gateway event forwarding"},
    {"source": "gateway_edge", "destination": "internet", "ports": [443], "protocol": "TCP", "allowed": true, "reason": "Outbound internet access"}
  ]
